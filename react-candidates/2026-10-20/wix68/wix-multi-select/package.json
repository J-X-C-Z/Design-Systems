{
  "name": "@studio/wix-multi-select",
  "version": "0.1.0-candidate.1",
  "description": "Two source-audited React nonmodal Popover multi-selects with immutable collection ownership, toggle buttons and native multi-value forms.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": {
      "types": "./src/styles.d.ts",
      "default": "./src/styles.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "reference",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/styles.css"
  ],
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "license": "MIT"
}
