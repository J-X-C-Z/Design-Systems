{
  "name": "midcentury-modern",
  "version": "1.0.0",
  "origin": "Original modern adaptation, not historical measured values",
  "color": {
    "paper": "#f5edda",
    "ink": "#23342f",
    "bright": "#b5422b",
    "ochre": "#d5aa37",
    "olive": "#768362",
    "light": "#d8dfc7"
  },
  "grammar": {
    "primitives": [
      "circle",
      "bridge",
      "bar"
    ],
    "mainShapeAreaSuggested": [
      0.25,
      0.45
    ],
    "auxiliaryAreaSuggested": [
      0.1,
      0.25
    ],
    "repeatTransforms": [
      "rotate90",
      "mirror",
      "omit within limit"
    ],
    "bodyTexture": false
  },
  "type": {
    "bodyPx": 18,
    "lineHeight": 1.8,
    "labelPx": 14
  },
  "motion": {
    "durationMs": 360,
    "maxRotationDeg": 12,
    "loops": 0,
    "meaning": "module relation change"
  },
  "constraints": [
    "not a uniform global historical style",
    "no copied Girard or Eames motifs",
    "decorative area does not encode data"
  ]
