{
  "name": "experimental-collage",
  "version": "1.0.0",
  "origin": "Original adaptation",
  "materials": {
    "base": "#e6dfcc",
    "paper": "#fffaf0",
    "ink": "#191b22",
    "cutRed": "#b52d25",
    "signalYellow": "#e9d94d",
    "cold": "#a8b5bd"
  },
  "composition": {
    "semanticMaterialClasses": [
      2,
      4
    ],
    "anchorCount": 1,
    "importantTextRotation": 0,
    "fragmentRotationDeg": [
      -8,
      8
    ],
    "shadowPx": [
      3,
      6
    ],
    "sourceLedgerRequired": true
  },
  "motion": {
    "transitionMs": 240,
    "easing": "steps(3,end)",
    "loops": 0,
    "states": [
      "isolate",
      "juxtapose",
      "annotate"
    ]
  },
  "constraints": [
    "facts retain proportions",
    "no unlicensed source fragments",
    "body text stays readable outside art"
  ]
}
