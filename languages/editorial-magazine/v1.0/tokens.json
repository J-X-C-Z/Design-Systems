{
  "name": "editorial-magazine",
  "version": "1.0.0",
  "origin": "Original editorial recommendations, not measured source tokens",
  "roles": {
    "masthead": "serif display",
    "headline": "serif / CJK Song fallback",
    "body": "CJK serif optional, 19px line-height 1.9",
    "label": "system sans 13px",
    "caption": "system sans 14px"
  },
  "color": {
    "paper": "#f6f0e5",
    "ink": "#25251f",
    "accent": "#9c331f",
    "secondary": "#4e554c"
  },
  "measure": {
    "bodyMax": "34em",
    "captionMax": "48ch",
    "columns": "1 on small; independent side rail on wide",
    "sectionGap": "clamp(48px,8vw,100px)"
  },
  "motion": {
    "focusMs": 180,
    "autoplay": false,
    "scrollHijack": false
  },
  "constraints": [
    "caption required for evidence images",
    "all narrative remains readable without JS",
    "same content roles across varying compositions"
  ]
}
