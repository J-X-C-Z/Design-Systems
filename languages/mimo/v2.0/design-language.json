{
  "id": "personal.mimo-inspired",
  "version": "2.0.0",
  "status": "personal-release",
  "name": "MiMo-inspired / 理性技术人文",
  "provenance": "Independent interpretation of Xiaomi MiMo references; not an official Xiaomi system.",
  "axes": {
    "branches": [
      "rational-humanistic",
      "dark-tech"
    ],
    "scenes": [
      "research",
      "developer",
      "workspace"
    ]
  },
  "decisions": {
    "layouts": "optional",
    "components": "optional",
    "motion": "language",
    "themeSwitch": "skin",
    "references": "both",
    "resources": "shared"
  },
  "identity": {
    "statement": "以清晰的结构承载复杂能力，以有人情味的表达保留人的主动权。",
    "invariants": [
      "type carries hierarchy",
      "content before interface chrome",
      "number and direction form navigation",
      "tools are real content",
      "motion makes relationships legible"
    ],
    "creativeFreedom": "Create new layouts, components and motion compositions. References are examples, not templates. Preserve purpose and meaning; do not mechanically copy geometry."
  },
  "typography": {
    "sans": "system-ui, -apple-system, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif",
    "mono": "ui-monospace, \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace",
    "displayLatin": {
      "weight": 650,
      "trackingEm": -0.055,
      "lineHeight": 0.98
    },
    "displayCJK": {
      "weight": 650,
      "trackingEm": -0.025,
      "lineHeight": 1.14
    },
    "body": {
      "sizePx": 16,
      "lineHeight": 1.75
    },
    "meta": {
      "sizePx": 12,
      "lineHeight": 1.5
    },
    "fontFilesBundled": false,
    "note": "System fallback font appearance varies by OS; no pixel-identical typography promise."
  },
  "geometry": {
    "spacingPx": [
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64,
      96
    ],
    "radiusPx": {
      "control": 4,
      "panel": 8,
      "composer": 14
    },
    "maxContentPx": 1440,
    "readingMeasure": "38em",
    "mobilePageGutterPx": 20,
    "comfortableTargetPx": 44,
    "breakpointsPx": {
      "compact": 600,
      "medium": 1000
    },
    "policy": "Defaults, not mandatory coordinates or a mandatory grid."
  },
  "branches": {
    "rational-humanistic": {
      "label": "理性人文",
      "short": "light",
      "tone": "纸面、清晰、开放、平静但不疏离",
      "color": {
        "canvas": "#F6F5F1",
        "surface": "#FFFFFF",
        "raised": "#EBEDE7",
        "ink": "#17201B",
        "muted": "#5B675F",
        "subtle": "#606C64",
        "rule": "#D0D5CC",
        "control": "#7C897F",
        "accent": "#96512F",
        "accentSoft": "#ECD9CA",
        "accentInk": "#703717",
        "action": "#1D2A23",
        "onAction": "#FFFFFF",
        "focus": "#315C9C",
        "success": "#21623F",
        "warning": "#805100",
        "danger": "#A02F34"
      },
      "material": "warm matte surfaces, quiet contour, precise rules",
      "defaultMotion": "direct / settled"
    },
    "dark-tech": {
      "label": "暗黑科技",
      "short": "dark",
      "tone": "深色工作面、克制焦点、明确层级，不等同霓虹科幻",
      "color": {
        "canvas": "#111814",
        "surface": "#18221C",
        "raised": "#233129",
        "ink": "#F0F3EC",
        "muted": "#B0BDAF",
        "subtle": "#A1B39F",
        "rule": "#3C5143",
        "control": "#829880",
        "accent": "#E3AF86",
        "accentSoft": "#493A2D",
        "accentInk": "#FFDCC0",
        "action": "#EDF1E8",
        "onAction": "#152019",
        "focus": "#A7C6FF",
        "success": "#A2DAB5",
        "warning": "#F0CA7F",
        "danger": "#FFAAA7"
      },
      "material": "layered neutral dark, local warm signals, no mandatory glow",
      "defaultMotion": "focused / settled"
    }
  },
  "motion": {
    "durationsMs": {
      "instant": 0,
      "micro": 160,
      "state": 280,
      "reveal": 520,
      "narrative": 900
    },
    "easing": {
      "settle": "cubic-bezier(.22,.75,.2,1)",
      "direct": "cubic-bezier(.2,0,0,1)",
      "linear": "linear"
    },
    "defaultDisplacementPx": {
      "hint": 5,
      "enter": 14,
      "surface": 8
    },
    "reducedPolicy": "nonessential spatial changes finish immediately; final content and meaningful state remain available",
    "continuousPolicy": "no ambient autoplay in the kit; explicit play/pause/reset",
    "authoredNotObserved": true
  },
  "scope": {
    "coreDependencies": [],
    "runtime": "CSS + browser Web Animations API",
    "spEngineDependency": false
  },
  "releaseContract": {
    "schemaVersion": 2,
    "snapshotVersioned": true,
    "mutateExistingAnimationsOnSkin": false,
    "externalAssetsRequired": false
  }
}
