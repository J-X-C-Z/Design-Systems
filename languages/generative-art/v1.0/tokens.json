{
  "name": "generative-art",
  "version": "1.0.0",
  "origin": "Original algorithm and recommendations",
  "canvas": {
    "width": 900,
    "height": 600,
    "paddingX": 50,
    "baselineY": [
      70,
      530
    ]
  },
  "parameters": {
    "seed": {
      "default": 42,
      "min": 0,
      "max": 4294967295,
      "meaning": "LCG starting state"
    },
    "lines": {
      "default": 48,
      "min": 24,
      "max": 72,
      "meaning": "density"
    },
    "amplitude": {
      "default": 45,
      "min": 0,
      "max": 80,
      "meaning": "departure from baseline"
    },
    "segments": 80
  },
  "palette": {
    "paper": "#101c25",
    "lines": [
      "#85d0c2",
      "#e6b58a",
      "#9eb7ef"
    ]
  },
  "motion": {
    "revealMs": 3000,
    "loops": 1,
    "geometryChanges": false
  },
  "reproduction": [
    "engine version",
    "seed",
    "lines",
    "amplitude",
    "palette",
    "900x600 viewBox"
  ],
  "constraints": [
    "not a data visualization",
    "no unbounded loops",
    "static export independent of motion"
  ]
}
